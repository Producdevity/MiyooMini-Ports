{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/Producdevity/MiyooMini-Ports/master/porters.schema.json",
  "title": "MiyooMini-Ports porters",
  "description": "Porter profiles. Keys are the handles used in ports.json porter arrays.",
  "type": "object",
  "required": ["porters"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "porters": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["github"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Display name, if different from the handle."
          },
          "github": {
            "type": "string",
            "pattern": "^https://",
            "description": "GitHub profile URL."
          },
          "social": {
            "type": "string",
            "pattern": "^https://",
            "description": "Social profile; YouTube, Reddit, Twitter, whatever."
          },
          "website": {
            "type": "string",
            "pattern": "^https://",
            "description": "Personal site; can be anything you want."
          },
          "donate": {
            "type": "string",
            "pattern": "^https://",
            "description": "Donation link (Patreon, Ko-fi, etc.)."
          },
          "bio": {
            "type": "string",
            "minLength": 1,
            "description": "Short bio. (Or long)"
          },
          "image": {
            "type": "string",
            "pattern": "^https://",
            "description": "Avatar or profile image URL."
          }
        }
      }
    }
  }
}
