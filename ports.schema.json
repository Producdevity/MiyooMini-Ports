{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/Producdevity/MiyooMini-Ports/master/ports.schema.json",
  "title": "MiyooMini-Ports catalog",
  "description": "Port entries for the Miyoo Mini family (SigmaStar SSD202D).",
  "type": "object",
  "required": ["ports"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "ports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "category",
          "status",
          "assets",
          "porter",
          "upstream",
          "image",
          "notes"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Display name."
          },
          "category": {
            "type": "string",
            "enum": [
              "app",
              "arcade",
              "engine",
              "fps",
              "platform",
              "puzzle",
              "racing",
              "reflex",
              "rpg",
              "shooter",
              "simulation"
            ],
            "description": "Genre. Reuse an existing value; add a new one only if nothing fits."
          },
          "status": {
            "type": "string",
            "enum": ["playable", "experimental", "prerelease", "source-only"],
            "description": "playable: runs well. experimental: runs but rough. prerelease: upstream author labels it pre-release. source only: no binary, user builds it."
          },
          "assets": {
            "type": "string",
            "enum": ["free", "owned"],
            "description": "free: nothing to supply. owned: user supplies game data."
          },
          "porter": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Porter handles, as keyed in porters.json."
          },
          "upstream": {
            "type": "string",
            "pattern": "^https://",
            "format": "uri",
            "description": "Link the /releases page (not a pinned version). Source-only ports with no releases link the repo root."
          },
          "image": {
            "type": "string",
            "format": "uri",
            "description": "Stable screenshot URL. GitHub user-attachment URLs are permanent."
          },
          "notes": {
            "type": "string",
            "minLength": 1,
            "description": "What to supply, device caveats, performance."
          }
        }
      }
    }
  }
}
